; particles_step.comp.spvasm -- SPIR-V compute shader for the particle
; gravity + wall-bounce physics step, replacing the OpenCL kernel
; (kernel_src in particles_physics.c, GLSL-equivalent logic) that used to
; run this simulation. Hand-authored SPIR-V assembly (no glslangValidator/
; glslc available in this environment -- only spirv-as/spirv-val/spirv-opt
; from the spirv-tools package), assembled with:
;   spirv-as --target-env vulkan1.0 particles_step.comp.spvasm -o particles_step.comp.spv
;   spirv-val particles_step.comp.spv
;
; Layout (std430, legacy pre-1.3 BufferBlock/Uniform form so this runs on
; any Vulkan 1.0 ICD including software/llvmpipe -- matches how glslang
; itself emitted SSBOs before SPIR-V 1.3's StorageBuffer storage class):
;   binding 0: PosBuf  { float data[]; }  -- same buffer as the graphics
;              pipeline's vertex buffer (stride 5 floats/particle: x,y,r,g,b)
;              -- this shader only ever touches data[i*5+0] (x) and
;              data[i*5+1] (y); r,g,b are written once by the host and never
;              touched again.
;   binding 1: VelBuf  { float data[]; }  -- stride 2 floats/particle (vx,vy)
;   push constant: float dt
;
; gl_GlobalInvocationID.x selects the particle index; local_size_x=64 with
; a bounds check (NUM_PARTICLES=200 isn't a multiple of 64, and Vulkan core
; only guarantees maxComputeWorkGroupInvocations >= 128, so a single
; 200-wide workgroup isn't portable) -- host dispatches ceil(200/64)=4
; workgroups.
OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main" %gl_GlobalInvocationID
OpExecutionMode %main LocalSize 64 1 1
OpSource GLSL 450

OpDecorate %gl_GlobalInvocationID BuiltIn GlobalInvocationId

OpDecorate %_runtimearr_float ArrayStride 4
OpMemberDecorate %PosBuf 0 Offset 0
OpDecorate %PosBuf BufferBlock
OpDecorate %posbuf DescriptorSet 0
OpDecorate %posbuf Binding 0

OpMemberDecorate %VelBuf 0 Offset 0
OpDecorate %VelBuf BufferBlock
OpDecorate %velbuf DescriptorSet 0
OpDecorate %velbuf Binding 1

OpMemberDecorate %PC 0 Offset 0
OpDecorate %PC Block

%void = OpTypeVoid
%voidfn = OpTypeFunction %void
%float = OpTypeFloat 32
%uint = OpTypeInt 32 0
%bool = OpTypeBool

%v3uint = OpTypeVector %uint 3
%_ptr_Input_v3uint = OpTypePointer Input %v3uint
%gl_GlobalInvocationID = OpVariable %_ptr_Input_v3uint Input
%_ptr_Input_uint = OpTypePointer Input %uint

%uint_0 = OpConstant %uint 0
%uint_1 = OpConstant %uint 1
%uint_2 = OpConstant %uint 2
%uint_5 = OpConstant %uint 5
%uint_200 = OpConstant %uint 200

%_runtimearr_float = OpTypeRuntimeArray %float
%PosBuf = OpTypeStruct %_runtimearr_float
%_ptr_Uniform_PosBuf = OpTypePointer Uniform %PosBuf
%posbuf = OpVariable %_ptr_Uniform_PosBuf Uniform
%VelBuf = OpTypeStruct %_runtimearr_float
%_ptr_Uniform_VelBuf = OpTypePointer Uniform %VelBuf
%velbuf = OpVariable %_ptr_Uniform_VelBuf Uniform
%_ptr_Uniform_float = OpTypePointer Uniform %float

%PC = OpTypeStruct %float
%_ptr_PushConstant_PC = OpTypePointer PushConstant %PC
%pc = OpVariable %_ptr_PushConstant_PC PushConstant
%_ptr_PushConstant_float = OpTypePointer PushConstant %float

%_ptr_Function_float = OpTypePointer Function %float

%float_1_6 = OpConstant %float 1.6
%float_0_85 = OpConstant %float 0.85
%float_0_55 = OpConstant %float 0.55
%float_1 = OpConstant %float 1
%float_n1 = OpConstant %float -1

%main = OpFunction %void None %voidfn
%entry = OpLabel
%px_var = OpVariable %_ptr_Function_float Function
%py_var = OpVariable %_ptr_Function_float Function
%vx_var = OpVariable %_ptr_Function_float Function
%vy_var = OpVariable %_ptr_Function_float Function

%gid_ptr = OpAccessChain %_ptr_Input_uint %gl_GlobalInvocationID %uint_0
%gid = OpLoad %uint %gid_ptr
%oob = OpUGreaterThanEqual %bool %gid %uint_200
OpSelectionMerge %after None
OpBranchConditional %oob %after %body

%body = OpLabel
%posbase = OpIMul %uint %gid %uint_5
%velbase = OpIMul %uint %gid %uint_2
%py_idx = OpIAdd %uint %posbase %uint_1
%vy_idx = OpIAdd %uint %velbase %uint_1

%px_ptr = OpAccessChain %_ptr_Uniform_float %posbuf %uint_0 %posbase
%px_load = OpLoad %float %px_ptr
OpStore %px_var %px_load
%py_ptr = OpAccessChain %_ptr_Uniform_float %posbuf %uint_0 %py_idx
%py_load = OpLoad %float %py_ptr
OpStore %py_var %py_load
%vx_ptr = OpAccessChain %_ptr_Uniform_float %velbuf %uint_0 %velbase
%vx_load = OpLoad %float %vx_ptr
OpStore %vx_var %vx_load
%vy_ptr = OpAccessChain %_ptr_Uniform_float %velbuf %uint_0 %vy_idx
%vy_load = OpLoad %float %vy_ptr
OpStore %vy_var %vy_load

%dt_ptr = OpAccessChain %_ptr_PushConstant_float %pc %uint_0
%dt = OpLoad %float %dt_ptr

; v.y -= 1.6 * dt
%vy0 = OpLoad %float %vy_var
%t1 = OpFMul %float %float_1_6 %dt
%vy1 = OpFSub %float %vy0 %t1
OpStore %vy_var %vy1

; p.x += v.x * dt
%vx0 = OpLoad %float %vx_var
%px0 = OpLoad %float %px_var
%t2 = OpFMul %float %vx0 %dt
%px1 = OpFAdd %float %px0 %t2
OpStore %px_var %px1

; p.y += v.y * dt
%vy2 = OpLoad %float %vy_var
%py0 = OpLoad %float %py_var
%t3 = OpFMul %float %vy2 %dt
%py1 = OpFAdd %float %py0 %t3
OpStore %py_var %py1

; if (p.x > 1.0) { p.x = 1.0; v.x = -v.x * 0.85; }
%pxA = OpLoad %float %px_var
%condA = OpFOrdGreaterThan %bool %pxA %float_1
OpSelectionMerge %mergeA None
OpBranchConditional %condA %thenA %mergeA
%thenA = OpLabel
OpStore %px_var %float_1
%vxA = OpLoad %float %vx_var
%negA = OpFNegate %float %vxA
%vxA2 = OpFMul %float %negA %float_0_85
OpStore %vx_var %vxA2
OpBranch %mergeA
%mergeA = OpLabel

; if (p.x < -1.0) { p.x = -1.0; v.x = -v.x * 0.85; }
%pxB = OpLoad %float %px_var
%condB = OpFOrdLessThan %bool %pxB %float_n1
OpSelectionMerge %mergeB None
OpBranchConditional %condB %thenB %mergeB
%thenB = OpLabel
OpStore %px_var %float_n1
%vxB = OpLoad %float %vx_var
%negB = OpFNegate %float %vxB
%vxB2 = OpFMul %float %negB %float_0_85
OpStore %vx_var %vxB2
OpBranch %mergeB
%mergeB = OpLabel

; if (p.y > 1.0) { p.y = 1.0; v.y = -v.y * 0.55; }
%pyA = OpLoad %float %py_var
%condC = OpFOrdGreaterThan %bool %pyA %float_1
OpSelectionMerge %mergeC None
OpBranchConditional %condC %thenC %mergeC
%thenC = OpLabel
OpStore %py_var %float_1
%vyC = OpLoad %float %vy_var
%negC = OpFNegate %float %vyC
%vyC2 = OpFMul %float %negC %float_0_55
OpStore %vy_var %vyC2
OpBranch %mergeC
%mergeC = OpLabel

; if (p.y < -1.0) { p.y = -1.0; v.y = -v.y * 0.55; }
%pyB = OpLoad %float %py_var
%condD = OpFOrdLessThan %bool %pyB %float_n1
OpSelectionMerge %mergeD None
OpBranchConditional %condD %thenD %mergeD
%thenD = OpLabel
OpStore %py_var %float_n1
%vyD = OpLoad %float %vy_var
%negD = OpFNegate %float %vyD
%vyD2 = OpFMul %float %negD %float_0_55
OpStore %vy_var %vyD2
OpBranch %mergeD
%mergeD = OpLabel

%pxFinal = OpLoad %float %px_var
%pxOutPtr = OpAccessChain %_ptr_Uniform_float %posbuf %uint_0 %posbase
OpStore %pxOutPtr %pxFinal
%pyFinal = OpLoad %float %py_var
%pyOutPtr = OpAccessChain %_ptr_Uniform_float %posbuf %uint_0 %py_idx
OpStore %pyOutPtr %pyFinal
%vxFinal = OpLoad %float %vx_var
%vxOutPtr = OpAccessChain %_ptr_Uniform_float %velbuf %uint_0 %velbase
OpStore %vxOutPtr %vxFinal
%vyFinal = OpLoad %float %vy_var
%vyOutPtr = OpAccessChain %_ptr_Uniform_float %velbuf %uint_0 %vy_idx
OpStore %vyOutPtr %vyFinal

OpBranch %after

%after = OpLabel
OpReturn
OpFunctionEnd
