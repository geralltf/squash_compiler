# Builds the Android Vulkan example APKs using squash's own -android
# backend (no aapt/apksigner/gradle/NDK anywhere in this process -- see
# `squash --help`'s own -android section). Two demos:
#   triangle -- android/examples/triangle_android.c: a real per-vertex-
#               color-interpolated Vulkan triangle.
#   buttons  -- android/examples/buttons_android.c: real HTML/CSS-driven
#               buttons + scrolling + hover + wrapped/unwrapped text, built
#               on SQW's own DOM/CSS/layout/text-rendering engine.
#   castles  -- android/examples/castles_android.c: an explorable 3D world
#               of seamless streamed terrain chunks (simplex/fBm water,
#               sand, grass, mountains), with Wave Function Collapse
#               laying out roads, bridges, forests and villages around
#               multi-chunk castles (square/triangle/polygon/star/circle,
#               0-3 inner rings, bastion forts, gatehouses, town centres,
#               houses, barracks); selectable procedurally generated and
#               animated swordsmen, archers and macemen with
#               GPU (Vulkan compute) flow-field pathfinding in 3D --
#               along the ground, up ramps and ladders, onto walls.
#
# Usage:
#   make -f Makefile.android_examples            # build both APKs
#   make -f Makefile.android_examples triangle    # build just the triangle
#   make -f Makefile.android_examples buttons     # build just the buttons demo
#   make -f Makefile.android_examples castles     # build just the castles game
#   make -f Makefile.android_examples install     # adb install both (device/emulator required)
#   make -f Makefile.android_examples run         # install + launch both, tail logcat briefly
#   make -f Makefile.android_examples clean       # remove built APKs

SQUASH       := ./squash
ADB          := adb

# triangle_spirv.h (shared shader bytecode) lives here, not in android/examples/.
SPIRV_DIR    := SDL3_Build/scratch
LIBS_DIR     := android/libs

COMMON_FLAGS := -android -android-activity -I $(SPIRV_DIR) -I . -L $(LIBS_DIR) -llog -lvulkan -landroid

TRIANGLE_SRC := android/examples/triangle_android.c
TRIANGLE_PKG := com.squash.triangledemo
TRIANGLE_APK := android/examples/triangle_android.apk

BUTTONS_SRC  := android/examples/buttons_android.c
BUTTONS_PKG  := com.squash.buttonsdemo
BUTTONS_APK  := android/examples/buttons_android.apk

FORMS_SRC    := android/examples/forms_android.c
FORMS_PKG    := com.squash.formsdemo
FORMS_APK    := android/examples/forms_android.apk

# castles_world.h (world + nav generation), castles_sites*.h (castles),
# castles_units.h (units), castles_ballistics.h (arrows) and
# castles_spirv.h (shaders,
# regenerated by android/examples/shaders/gen_spirv_header.py) are
# #included, so they're listed as prerequisites too.
CASTLES_SRC  := android/examples/castles_android.c
CASTLES_DEPS := android/examples/castles_world.h android/examples/castles_sites.h android/examples/castles_sites_build.h android/examples/castles_structures.h android/examples/castles_units.h android/examples/castles_ballistics.h android/examples/castles_spirv.h
CASTLES_PKG  := com.squash.castles
CASTLES_APK  := android/examples/spark.apk

.PHONY: all triangle buttons forms castles clean install install-triangle install-buttons install-forms install-castles run run-triangle run-buttons run-forms run-castles

all: triangle buttons forms castles

triangle: $(TRIANGLE_APK)

buttons: $(BUTTONS_APK)

forms: $(FORMS_APK)

castles: $(CASTLES_APK)

$(TRIANGLE_APK): $(TRIANGLE_SRC) $(SQUASH)
	$(SQUASH) $(COMMON_FLAGS) -android-package $(TRIANGLE_PKG) $(TRIANGLE_SRC) -o $@

$(BUTTONS_APK): $(BUTTONS_SRC) $(SQUASH)
	$(SQUASH) $(COMMON_FLAGS) -android-package $(BUTTONS_PKG) $(BUTTONS_SRC) -o $@

$(FORMS_APK): $(FORMS_SRC) $(SQUASH)
	$(SQUASH) $(COMMON_FLAGS) -android-package $(FORMS_PKG) $(FORMS_SRC) -o $@

$(CASTLES_APK): $(CASTLES_SRC) $(CASTLES_DEPS) $(SQUASH)
	$(SQUASH) $(COMMON_FLAGS) -android-package $(CASTLES_PKG) $(CASTLES_SRC) -o $@

clean:
	rm -f $(TRIANGLE_APK) $(BUTTONS_APK) $(FORMS_APK) $(CASTLES_APK)

install-triangle: $(TRIANGLE_APK)
	$(ADB) install -r $(TRIANGLE_APK)

install-buttons: $(BUTTONS_APK)
	$(ADB) install -r $(BUTTONS_APK)

install-forms: $(FORMS_APK)
	$(ADB) install -r $(FORMS_APK)

install-castles: $(CASTLES_APK)
	$(ADB) install -r $(CASTLES_APK)

install: install-triangle install-buttons install-forms install-castles

run-triangle: install-triangle
	$(ADB) shell am force-stop $(TRIANGLE_PKG)
	$(ADB) logcat -c
	$(ADB) shell am start -n $(TRIANGLE_PKG)/com.squash.runtime.SquashActivity
	sleep 2
	$(ADB) logcat -d | grep -i squashvk | tail -40

run-buttons: install-buttons
	$(ADB) shell am force-stop $(BUTTONS_PKG)
	$(ADB) logcat -c
	$(ADB) shell am start -n $(BUTTONS_PKG)/com.squash.runtime.SquashActivity
	sleep 2
	$(ADB) logcat -d | grep -i squashbtn | tail -40

run-forms: install-forms
	$(ADB) shell am force-stop $(FORMS_PKG)
	$(ADB) logcat -c
	$(ADB) shell am start -n $(FORMS_PKG)/com.squash.runtime.SquashActivity
	sleep 2
	$(ADB) logcat -d | grep -i sqwforms | tail -40

run-castles: install-castles
	$(ADB) shell am force-stop $(CASTLES_PKG)
	$(ADB) logcat -c
	$(ADB) shell am start -n $(CASTLES_PKG)/com.squash.runtime.SquashActivity
	sleep 4
	$(ADB) logcat -d -s castles | tail -60

run: run-triangle run-buttons run-forms run-castles
